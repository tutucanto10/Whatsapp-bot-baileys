# BOT CONFIGURATION
BOT_NAME=LBOT v2.0
PREFIX=!
OWNER_NUMBER=5511999999999

# AI CONFIGURATION
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
AI_MODEL=gpt-3.5-turbo

# FEATURES
ENABLE_AI=false
ENABLE_DOWNLOADS=true
ENABLE_STICKERS=true
ENABLE_ANTI_SPAM=true
ENABLE_ANTI_LINK=true

# ANTI-SPAM SETTINGS
MAX_MESSAGES_PER_MINUTE=10
SPAM_BAN_DURATION=300000

# DATABASE
DB_TYPE=json
MONGODB_URI=

# ENVIRONMENT
NODE_ENV=development
PORT=3000

# API KEYS (Opcionais - para buscas avançadas)
# Google Custom Search: https://developers.google.com/custom-search
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Unsplash (para busca de imagens): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# YouTube Data API: https://console.cloud.google.com
YOUTUBE_API_KEY=
